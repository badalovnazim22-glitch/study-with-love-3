<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="study_progress.xml" />
    <include domain="database" path="study_mistakes.db" />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="study_progress.xml" />
        <include domain="file" path="." />
        <exclude domain="sharedpref" path="timer_runtime.xml" />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
